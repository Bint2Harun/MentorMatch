# Copy to `.env` and fill in from your Supabase project settings
# (Project Settings -> API). `.env` is gitignored; never commit real keys.
#
# The anon key is designed to be public and is protected by Row Level Security.
# Do NOT put the service_role key here - it bypasses RLS and must only ever
# appear in server-side code.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key